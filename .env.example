# Server-side only. Set these as Namecheap/cPanel environment variables where available,
# or write them into an untracked api/config.local.php outside the public web root.
# NEVER put actual tokens into frontend files or into a public .env.
TFNSW_API_KEY=replace_with_your_own_TfNSW_Trip_Planner_API_key
# Optional: URL must be HTTPS and point to the official TfNSW Trip Planner v1 gateway.
TFNSW_API_BASE=https://api.transport.nsw.gov.au/v1/tp
# APP_DEMO=1 enables fixture-based preview only if enabled explicitly. Do not enable in production.
APP_DEMO=0
